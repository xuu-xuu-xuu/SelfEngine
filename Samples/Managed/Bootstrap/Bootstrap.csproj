<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SelfEngine.Bootstrap</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(SelfEngineRepositoryRoot)Source/FunctionLayer/Scripting/Managed/Engine.Managed.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="$(SelfEngineRepositoryRoot)Samples/Managed/ProjectScripts/ProjectScripts.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <Target Name="CopyProjectScripts" AfterTargets="Build">
    <ItemGroup><SampleScript Include="$(SelfEngineManagedOutputRoot)ProjectScripts\$(Configuration)\net10.0\SelfEngine.ProjectScripts.*" /></ItemGroup>
    <Copy SourceFiles="@(SampleScript)" DestinationFolder="$(TargetDir)ProjectScripts" />
  </Target>
  <Target Name="PublishProjectScripts" AfterTargets="Publish">
    <ItemGroup><PublishedScript Include="$(TargetDir)ProjectScripts\*" /></ItemGroup>
    <Copy SourceFiles="@(PublishedScript)" DestinationFolder="$(PublishDir)ProjectScripts" />
  </Target>
</Project>
